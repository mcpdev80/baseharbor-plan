filters:
  and:
    - 'file.inFolder("tasks")'
    - 'file.ext == "md"'
    - 'kanban_status != null'
properties:
  kanban_title:
    displayName: Aufgabe
  kanban_status:
    displayName: Status
  priority:
    displayName: Prioritaet
  owner:
    displayName: Bearbeiter
  release:
    displayName: Release
views:
  - type: kanban
    name: "v0.4.27"
    filters:
      and:
        - 'note.release == "v0.4.27"'
    groupBy:
      property: note.kanban_status
      direction: ASC
    groupOrder:
      - backlog
      - planned
      - active
      - review
      - blocked
      - closed
    order:
      - kanban_title
      - priority
  - type: kanban
    name: "v0.4.26"
    filters:
      and:
        - 'note.release == "v0.4.26"'
