filters:
  and:
    - file.inFolder("tasks")
    - file.ext == "md"
    - kanban_status != null
properties:
  kanban_title:
    displayName: Aufgabe
  kanban_status:
    displayName: Lebenszyklus
  kanban_lane:
    displayName: Spalte
  kanban_summary:
    displayName: Kurzbeschreibung
  id:
    displayName: ID
  priority:
    displayName: Priorität
  areas:
    displayName: Themen
  owner:
    displayName: Bearbeiter
  release:
    displayName: Release
views:
  - type: kanban
    name: v0.4.27
    filters:
      and:
        - note.release == "v0.4.27"
    groupBy:
      property: note.kanban_lane
      direction: ASC
    groupOrder:
      - backlog
      - planned
      - ready
      - active
      - wait
      - review
      - blocked
    order:
      - note.kanban_title
      - note.id
      - note.owner
      - note.kanban_summary
      - note.priority
      - note.areas
    columnWidth: 420
